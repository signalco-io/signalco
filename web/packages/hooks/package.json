{
    "name": "@signalco/hooks",
    "version": "0.2.1",
    "sideEffects": false,
    "type": "module",
    "license": "MIT",
    "exports": {
        "./*": "./src/*.ts"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "exports": {
            "./*": {
                "import": "./dist/*.js",
                "types": "./dist/*.d.ts"
            }
        }
    },
    "scripts": {
        "test": "node --experimental-vm-modules --test tests/*.test.mjs",
        "prepublishOnly": "tsup --env.NODE_ENV production"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "7.59.4",
        "@signalco/js": "workspace:*",
        "@signalco/tsconfig": "workspace:*",
        "@types/react": "19.2.2",
        "next": "16.4.3",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "tsup": "8.5.1",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "next": ">=15",
        "react": ">=19",
        "react-dom": ">=19"
    }
}
